{
  "name": "litoria",
  "version": "0.1.2-SNAPSHOT",
  "description": "A Command Line Tool to manage asciidoctor projet; create, add content, watch content and convert it into html, pdf & epub3 files for documents, reports, revealjs slideshow, hands on lab & more",
  "license": "Apache-2.0",
  "author": "Charles Moulliard",
  "maintainers": [
    {
      "name": "cmoulliard",
      "email": "ch007m@gmail.com"
    }
  ],
  "homepage": "https://github.com/ch007m/litoria#README.md",
  "bugs": "https://github.com/ch007m/litoria/issues",
  "keywords": [
    "asciidoctor",
    "render",
    "pdf",
    "html",
    "revealjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ch007m/litoria.git"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@asciidoctor/reveal.js": "6.0.0-beta.2",
    "asciidoctor": "^4.0.8",
    "@hapi/hapi": "^21.4.8",
    "@hapi/inert": "^7.1.2",
    "async": "^2.0.1",
    "chalk": "^1.1.3",
    "cheerio": "^1.1.2",
    "commander": "^2.9.0",
    "fs-extra": "^0.30.0",
    "glob": "^7.0.6",
    "grunt": "^1.0.4",
    "puppeteer": "^24.9.0",
    "inline-css": "^4.0.3",
    "nodemailer": "^9.0.1",
    "opener": "^1.4.1",
    "tar-fs": "^3.1.1",
    "yamljs": "^0.2.8"
  },
  "scripts": {
    "test": "tape test/*.js | tap-min",
    "lint": "eslint bin/*.js lib/*.js test/*.js",
    "coverage": "nyc npm test",
    "release": "release-it"
  },
  "bin": {
    "litoria": "bin/litoria.js"
  },
  "devDependencies": {
    "eslint": "^8.22.0",
    "nyc": "^18.0.0",
    "proxyquire": "^1.7.10",
    "release-it": "^21.0.2",
    "should": "^11.1.0",
    "tap-min": "^3.0.0",
    "tape": "^4.6.0",
    "test-console": "^1.0.0"
  },
  "overrides": {
    "parse-url": "11.1.0",
    "encoding-sniffer": "1.0.2"
  },
  "allowScripts": {
    "puppeteer": true
  }
}
